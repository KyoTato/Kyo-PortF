{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run React App",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\node.exe",
      "runtimeArgs": [
        "${workspaceFolder}\\node_modules\\vite\\bin\\vite.js",
        "--host",
        "0.0.0.0",
        "--port",
        "5173"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
